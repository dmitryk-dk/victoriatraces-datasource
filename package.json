{
  "name": "victoriametrics-traces-datasource",
  "version": "0.1.0",
  "description": "VictoriaTraces datasource plugin for Grafana",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --onlyChanged",
    "test:ci": "jest --maxWorkers 4",
    "test:coverage": "jest --collectCoverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix",
    "server": "docker compose up",
    "sign": "npx --yes @grafana/sign-plugin@latest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:conformance": "playwright test e2e/filters.conformance.spec.ts"
  },
  "author": "dmitryk-dk",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/plugin-e2e": "^3.14.0",
    "@grafana/tsconfig": "^2.0.1",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.15.18",
    "@swc/helpers": "^0.5.19",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.52",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.4.0",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^50.6.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^5.0.3",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^13.0.6",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "1.97.3",
    "sass-loader": "16.0.7",
    "style-loader": "4.0.0",
    "swc-loader": "^0.2.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.2.3",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-merge": "^6.0.1",
    "webpack-subresource-integrity": "^5.2.0-rc.1",
    "webpack-virtual-modules": "^0.6.2"
  },
  "overrides": {
    "ajv": "^6.14.0",
    "ajv-keywords": "^3.5.2",
    "schema-utils": "^3.3.0",
    "hermes-parser": "^0.36.1"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@grafana/data": "^13.2.2",
    "@grafana/runtime": "^13.2.2",
    "@grafana/schema": "^13.2.2",
    "@grafana/ui": "^13.2.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@xyflow/react": "^12.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^2.15.3",
    "tslib": "2.8.1"
  }
}
