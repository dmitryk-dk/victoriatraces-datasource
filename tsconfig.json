{
  "compilerOptions": {
    "jsx": "react",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "plugins/victoriatraces-datasource",
    "allowJs": true,
    "strict": true,
    "resolveJsonModule": true,
    "useUnknownInCatchVariables": true,
    "incremental": true,
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },
  "extends": "./.config/tsconfig.json",
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "plugins",
    "release",
    "dist",
    "coverage",
    ".config/**",
    "webpack.config.ts"
  ]
}
